# ---- Mode recommandé : proxy Next.js (app/api/backend/[...path]/route.ts) ----
# Le navigateur n'appelle que ton propre domaine Next.js ; pas de souci CORS.
# Variable SERVEUR uniquement (jamais exposée au navigateur, donc sans NEXT_PUBLIC_) :
#BACKEND_API_URL=http://localhost:8080

# NEXT_PUBLIC_API_BASE_URL n'a pas besoin d'être définie dans ce mode :
# lib/api/client.ts utilise "/api/backend" par défaut.

# ---- Mode alternatif : appel direct au backend depuis le navigateur ----
# Nécessite que le backend Spring Boot autorise le CORS pour ton domaine front.
# Racine de l'API SANS la version (le code ajoute "v1/" lui-même, voir app/api/apiConfig.ts) :
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/ob/api/
# NEXT_PUBLIC_API_BASE_URL=https://sotina.offbac.sn/ob/api/

